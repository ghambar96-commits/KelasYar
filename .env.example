# ============================================================================
# KelasYar - example environment configuration
# Copy this file to `.env` and fill in real values.  NEVER commit `.env`.
# ============================================================================

# --- Application ------------------------------------------------------------
APP_NAME="KelasYar"
TIMEZONE="Asia/Tehran"

# SQLite (default, good for development & small deployments):
DATABASE_URL="sqlite+aiosqlite:///./kelasyar.db"
# PostgreSQL (recommended for production):
# DATABASE_URL="postgresql+asyncpg://kelasyar:CHANGE_ME@localhost:5432/kelasyar"

UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=20
LOG_LEVEL="INFO"

# Create tables automatically on startup (dev convenience).
# For production prefer:  alembic upgrade head
AUTO_CREATE_TABLES=false

# --- Telegram ----------------------------------------------------------------
# 1. Talk to @BotFather in Telegram -> /newbot -> copy the token here.
TELEGRAM_BOT_TOKEN=""

# 2. Telegram numeric User ID(s) that should own the SUPER_ADMIN role.
#    (Find your ID via @userinfobot.)  Comma separated for multiple admins.
#    SUPER_ADMIN can ONLY be granted through this variable - never via bot/API.
SUPER_ADMIN_TELEGRAM_IDS="123456789"

# Set to false to run the REST API without the bot (e.g. separate processes).
BOT_ENABLED=true

# --- Telegram proxy (برای شبکه‌هایی که تلگرام در آن‌ها فیلتر است) -----------
# حالت خودکار (پیشنهادی): TELEGRAM_PROXY_URL را خالی بگذارید —
#   ابتدا اتصال مستقیم امتحان می‌شود؛ اگر ممکن نبود، پورت‌های پروکسی محلیِ رایج
#   (Hiddify: 12334 ، v2rayN: 10808/10809 ، Clash: 7890 و ...) خودکار بررسی
#   می‌شوند و اولین مسیر سالم انتخاب می‌گردد.
# تنظیم صریح (در صورت نیاز)، مثلاً:
#   TELEGRAM_PROXY_URL="socks5://127.0.0.1:12334"
TELEGRAM_PROXY_URL=""
TELEGRAM_PROXY_AUTO=true

# --- Security (REQUIRED) ------------------------------------------------------
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=""
JWT_ALGORITHM="HS256"
JWT_EXPIRE_DAYS=7
AUTH_CODE_TTL_MINUTES=10

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- API server ---------------------------------------------------------------
API_HOST="0.0.0.0"
API_PORT=8000

# --- CORS (optional) ----------------------------------------------------------
# Comma separated list of allowed origins for browser clients, e.g.:
# CORS_ORIGINS="https://panel.example.com,http://localhost:3000"
CORS_ORIGINS=""
